    {
      "id": 35,
      "type": "timeseries",
      "title": "Idempotency replay ratio",
      "description": "A sudden rise means a caller is retrying, which means something upstream is timing out. Idempotency working is not the same as idempotency being needed \u2014 this is the panel that tells them apart.",
      "datasource": {
        "type": "prometheus",
        "uid": "cf-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cf-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(ledger_idempotency_replay_total[5m])) / clamp_min(sum(rate(ledger_postings_total[5m])), 1e-9)",
          "legendFormat": "replay ratio",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A",
          "exemplar": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom",
