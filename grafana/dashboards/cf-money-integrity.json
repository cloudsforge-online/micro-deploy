            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisGridShow": true,
            "axisBorderShow": false,
            "spanNulls": false,
            "insertNulls": 300000
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
