        {
          "datasource": {
            "type": "prometheus",
            "uid": "cf-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (status) (rate(http_requests_total{service=\"$service\",status=~\"[45]..\"}[5m]))",
          "legendFormat": "{{status}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A",
          "exemplar": false
