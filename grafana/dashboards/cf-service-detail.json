{
  "uid": "cf-service-detail",
  "title": "CloudsForge \u00b7 Service detail",
  "description": "Owner: the service's team. Question: why is THIS service unhealthy?",
  "tags": [
    "cloudsforge"
  ],
  "timezone": "utc",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "cf-prometheus"
        },
        "query": {
          "query": "label_values(http_requests_total, service)",
          "refId": "cf-service"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "#e8622c",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#7d5ce0",
        "name": "Deploys",
        "target": {
          "limit": 100,
          "matchAny": false,
          "tags": [
            "deploy"
          ],
          "type": "tags"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 15,
      "type": "row",
      "title": "RED \u2014 $service",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Request rate by route",
      "description": "Route cardinality is unbounded, so this is the one place a fixed eight-slot assignment cannot apply. One hue, and the route you want is found by hovering \u2014 not by hunting a colour that means nothing.",
      "datasource": {
        "type": "prometheus",
        "uid": "cf-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cf-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (route) (rate(http_requests_total{service=\"$service\"}[5m]))",
          "legendFormat": "{{route}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A",
          "exemplar": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#e8622c"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisGridShow": true,
            "axisBorderShow": false,
            "spanNulls": false,
            "insertNulls": 300000
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#7fae5c",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Errors by status",
      "description": "4xx and 5xx together here, split by code, because the SHAPE of the split is the diagnosis: a wall of 401s is an auth change, a wall of 502s is an upstream.",
