    {
      "id": 18,
      "type": "timeseries",
      "title": "Latency quantiles",
      "description": "Exemplars ON: each bucket carries the trace id of a request in it, so a p99 spike is one click to the trace that was slow rather than a search for one. This is the panel AD-20's exemplar requirement exists for. Quantiles take the ordinal ember ramp, not three categorical hues \u2014 they are one measurement at increasing severity.",
      "datasource": {
        "type": "prometheus",
        "uid": "cf-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cf-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_ms_bucket{service=\"$service\"}[5m])))",
          "legendFormat": "p50",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A",
          "exemplar": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cf-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_ms_bucket{service=\"$service\"}[5m])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "B",
          "exemplar": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cf-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_ms_bucket{service=\"$service\"}[5m])))",
          "legendFormat": "p99",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "C",
          "exemplar": true
        }
      ],
