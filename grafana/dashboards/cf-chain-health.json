  "panels": [
    {
      "id": 44,
      "type": "timeseries",
      "title": "Indexer lag, in blocks",
      "description": "Both series are BLOCKS, which is why the confirmation depth may share this panel \u2014 it is the same unit and the same scale. Past the depth, deposits are provably not being credited, and that pages. Hearth's depth is 60 and Bitcoin's is not, so the threshold is read from the chain rather than hardcoded. Runbook: https://github.com/cloudsforge-online/stack/blob/main/micro/deploy/runbooks/runbook-indexer-lag.md",
      "datasource": {
        "type": "prometheus",
        "uid": "cf-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cf-prometheus"
          },
          "editorMode": "code",
          "expr": "indexer_lag_blocks",
          "legendFormat": "{{chain}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A",
          "exemplar": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cf-prometheus"
          },
          "editorMode": "code",
          "expr": "indexer_confirmation_depth",
          "legendFormat": "depth \u2014 {{chain}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "B",
          "exemplar": false
        }
      ],
