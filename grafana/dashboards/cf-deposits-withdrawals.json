  "panels": [
    {
      "id": 36,
      "type": "stat",
      "title": "Stuck withdrawals",
      "description": "PAGES ON >= 1. One user unable to get their money out is the failure this platform is least allowed to have, and it is invisible to every latency and error-rate metric \u2014 the request succeeded, the money did not move. Runbook: https://github.com/cloudsforge-online/stack/blob/main/micro/deploy/runbooks/runbook-stuck-withdrawal.md",
      "datasource": {
        "type": "prometheus",
        "uid": "cf-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cf-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(withdrawal_stuck_total)",
          "legendFormat": "stuck",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "text": {
          "valueSize": 48
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#7fae5c",
                "value": null
              },
              {
                "color": "#d2543a",
                "value": 1
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 37,
      "type": "bargauge",
      "title": "Deposit funnel \u2014 detected \u2192 confirmed \u2192 credited",
      "description": "An ORDINAL funnel: the stages are a sequence, so the form is a sorted bar and the reading is where the drop is. Detected-but-not-credited is a user staring at a wallet that has not changed.",
      "datasource": {
        "type": "prometheus",
        "uid": "cf-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "cf-prometheus"
          },
          "editorMode": "code",
          "expr": "wallet_deposit_total",
          "legendFormat": "{{stage}}",
          "range": false,
          "instant": true,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "valueMode": "text",
        "sizing": "auto",
        "minVizWidth": 8,
        "minVizHeight": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "max": null,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#7fae5c",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 38,
      "type": "stat",
      "title": "Frozen deposit addresses",
      "description": "Crediting has stopped on these addresses; the only fix is a recorded manual sweep. This metric exists so it is visible before the user complains. Runbook: https://github.com/cloudsforge-online/stack/blob/main/micro/deploy/runbooks/runbook-frozen-deposit-address.md",
      "datasource": {
        "type": "prometheus",
        "uid": "cf-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 16,
        "y": 0
