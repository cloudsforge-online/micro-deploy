# grafana — no secrets. The admin password is interpolated from ../../.env in
# the compose `environment:` block; everything below is configuration.

GF_SECURITY_ADMIN_USER=admin

# Anonymous access is off. Grafana is the operator plane; the public surface is
# Beacon's status page, which is a different projection with a different
# redaction policy (13-operational-model.md §6).
GF_AUTH_ANONYMOUS_ENABLED=false

# Sign-up off: accounts come from the org, not from whoever reaches the port.
GF_USERS_ALLOW_SIGN_UP=false

# Dark only. The CloudsForge system is dark-first (`.cf-dark`,
# `color-scheme: dark`) and there is no light mode in any app; the validated
# palette in assets/chart-palette.md was checked against the dark panel surface
# #141110 and nothing else. Serving these dashboards light would put every
# series colour on a surface it was never validated against.
GF_USERS_DEFAULT_THEME=dark

# Exemplars — the AD-20 "p99 spiked, show me the trace" link — need the trace
# datasource wired, which provisioning does, plus this feature on.
GF_FEATURE_TOGGLES_ENABLE=traceToMetrics,traceqlEditor

# No phoning home. This stack runs beside a platform holding customer money.
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
GF_NEWS_NEWS_FEED_ENABLED=false

# Provisioned dashboards are read-only in the UI on purpose: a panel edited in
# the browser is a change no repository has, and it is lost on the next deploy.
# Edit the JSON, not the page.
GF_DASHBOARDS_MIN_REFRESH_INTERVAL=10s
GF_LOG_LEVEL=warn
