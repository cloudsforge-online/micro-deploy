# otel-collector — three variables, because it uses three.
#
# The estate's compose hands eight services all 64 variables from one
# `env_file: .env`, which is how the game container ends up holding the custody
# master secret. Per-service env files make that impossible by construction:
# a variable a container was never given cannot leak from it.
#
# No secrets belong in this file. Anything sensitive is interpolated from
# ../../.env into the compose `environment:` block instead.

# Deployment environment, stamped onto every span, metric and log as
# `deployment.environment`. It is a Loki label and a Grafana variable.
OTEL_ENV=local

# Collector's own logs. `info` is right; `debug` on a collector produces a log
# line per batch, which is a monitor becoming the load.
OTEL_LOG_LEVEL=info

# Where Lantern accepts OTLP logs. AD-20 moves Lantern from Docker-socket pull
# to push, and this is the push address. Empty is a supported mode: the exporter
# is present in the pipeline but its endpoint is unreachable, which the
# collector reports as a queue error rather than dropping the whole pipeline.
# Point it at the Lantern that ships the OTLP receiver (P3), not at today's.
LANTERN_OTLP_ENDPOINT=http://lantern:4010/otlp
