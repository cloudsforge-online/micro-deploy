# prometheus — no secrets.
#
# The Beacon scrape credential is NOT here. Prometheus reads it from
# /etc/prometheus/secrets/beacon_token via `http_headers: files:`, because a
# token in a config file is a token in a backup, in a diff and in a screenshot.
# See ../../prometheus/prometheus.yml and ../../README.md §Secrets.

# Prometheus reads no configuration from the environment; it is here so the
# per-service env-file convention is uniform and a future variable has an
# obvious home rather than being appended to a shared file.
TZ=UTC
