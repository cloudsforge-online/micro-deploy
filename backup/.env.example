# The backup runner's configuration. Every variable this deployable reads is in src/env.ts and
# nowhere else, so this file can be derived from it (rule 9).
#
# NOTHING HERE IS A CUSTODY SECRET, AND NOTHING HERE EVER MAY BE. src/keyring.ts refuses to start if
# a CUSTODY_MASTER_SECRET_V<n> is present in this process's environment at all: this process writes
# the custody vault, and the vault and the keyring must never share a medium
# (docs/custody-backup-restore.md §1.5, §4.1).

# Which estate this IS. mainnet | testnet | development.
# One half of the cross-environment restore refusal; the other half is written inside the artefact.
# Never accepted from a job payload, a route or a manifest.
BACKUP_ENVIRONMENT=development
BACKUP_COMPOSE_PROJECT=cloudsforge-estate

# The catalogue: admin_api's own database, holding jobs, backup_runs, backup_artefacts,
# restore_runs and backup_settings.
BACKUP_ADMIN_DATABASE_URL=postgres://cloudsforge:change-me@postgres:5432/admin_api

# The cluster, as a role that can pg_dump every database and create/drop them. Two DSNs in one
# process is exactly why this is a separate deployable from admin-api — see src/env.ts.
BACKUP_CLUSTER_URL=postgres://cloudsforge:change-me@postgres:5432/postgres

# Where sets are written inside the container. The host side is /home/malf/cloudsforge-backups and
# NOT /data/... — snap-packaged Docker cannot see /data, and a bind of a path it cannot see becomes
# an empty ephemeral directory in which every write silently succeeds. See the compose overlay.
BACKUP_ROOT=/backups

# The read-only sources.
BACKUP_CUSTODY_VAULT_DIR=/vault/custody-keys/keys
BACKUP_STUDIO_ASSETS_DIR=/volumes/studio-assets
BACKUP_WORLD_ASSETS_DIR=/world-assets
BACKUP_MINER_KEYS_DIR=/miner-keys

# An age PUBLIC key (age1…), for encrypting the miner coinbase key before it is written.
# It is not a secret: publish it, log it, commit it. The PRIVATE identity must never exist on this
# host. Generate the pair somewhere else with `age-keygen`, keep the identity with the paper backup
# from docs/custody-backup-restore.md §4.1, and put only the public half here.
# Unset means the coinbase key is not backed up and the manifest says so. There is no path that
# writes a private key in the clear.
BACKUP_AGE_RECIPIENT=

LOG_LEVEL=info
PORT=4130
